# 7. 
cd ../..
#init config open.mp/docker/data/config.json
    ...
    "max_bots": 1,
    "max_players": 101,
    ...
        "legacy_plugins": [
	    "MapAndreas.so",
	    "crashdetect.so",
	    "mysql_static.so",
	    "streamer.so",
	    "things.so",
	    "translator.so"
	    ],
        "main_scripts": [
            "DayZ+ 1"
        ],

# 8. build & run server
# restart docker
cd open.mp/docker
./run.sh

# 9. to stop the server:
docker stop $(docker ps|grep "open\.mp"|awk -F " " {'print $1'})

#10. don't forget to change the server rcon password!

